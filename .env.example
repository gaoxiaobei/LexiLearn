# LexiLearn Configuration Example
# Copy this file to .env and customize as needed

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
API_BASE_URL=https://api.openai.com/v1/chat/completions
API_MODEL=gpt-4o-mini
API_MAX_RETRIES=3
API_TIMEOUT=30

# Processing Configuration
BATCH_SIZE=10
CONNECTOR_LIMIT=10
SLEEP_TIME=0.5
USE_TARGET_WORDS=true
MAX_CONCURRENT_REQUESTS=5

# File Configuration
INPUT_ARTICLE=input_article.txt
KNOWN_WORDS_FILE=known_words.txt
TARGET_WORDS_FILE=target_words.txt
LEARNED_WORDS_FILE=learned_words.txt
OUTPUT_ARTICLE=output_article.txt
LOG_FILE=lexilearn.log

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true